  "components": {
    "schemas": {
      "Create": {
        "properties": {
          "origin": {
            "type": "string",
            "enum": [
              "A",
              "B"
            ],
            "title": "Origin",
            "default": "A"
          },
          "destination": {
            "type": "string",
            "const": "D",
            "title": "Destination",
            "default": "D"
          },
          "passenger_ready": {
            "type": "boolean",
            "title": "Passenger Ready",
            "default": true
          },
          "allowed_walking_limit": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Allowed Walking Limit",
            "default": 200
          },
          "client_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Client Id",
            "default": "synthetic"
          }
        },
        "type": "object",
        "title": "Create"
      },
      "Event": {
        "properties": {
          "schema_version": {
            "type": "integer",
            "const": 1,
            "title": "Schema Version",
            "default": 1
          },
          "run_id": {
            "type": "string",
            "title": "Run Id"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "ride_id": {
            "type": "string",
            "title": "Ride Id"
          },
          "mission_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Mission Version"
          },
          "producer_sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Producer Sequence"
          },
          "boot_id": {
            "type": "string",
            "title": "Boot Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "ACK",
              "REJECTED",
              "APPROACHING",
              "READY_FOR_BOARDING",
              "IN_TRIP",
              "DROPOFF_READY",
              "COMPLETED",
              "CANCELLED",
              "TELEMETRY",
              "HOLDING",
              "FAILED"
            ],
            "title": "Kind"
          },
          "time": {
            "type": "number",
            "minimum": 0.0,
            "title": "Time"
          },
          "observation": {
            "additionalProperties": true,
            "type": "object",
            "title": "Observation"
          },
          "execution": {
            "type": "string",
            "title": "Execution"
          },
          "causation_id": {
            "type": "string",
            "title": "Causation Id"
          },
          "command_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Command Id"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "run_id",
          "event_id",
          "ride_id",
          "mission_version",
          "producer_sequence",
          "boot_id",
          "kind",
          "time",
          "observation",
          "execution",
          "causation_id"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Pickup": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          },
          "pickup": {
            "type": "string",
            "const": "B",
            "title": "Pickup",
            "default": "B"
          },
          "operator": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Operator"
          },
          "reason": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "expected_revision",
          "operator",
          "reason"
        ],
        "title": "Pickup"
      },
      "Revision": {
        "properties": {
          "expected_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Expected Revision"
          }
        },
        "type": "object",
        "required": [
          "expected_revision"
        ],
        "title": "Revision"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
